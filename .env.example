##############################################
# ITS API 설정
##############################################
ITS_API_KEY=REPLACE_WITH_ITS_API_KEY
ITS_API_URL=https://openapi.its.go.kr:9443/cctvInfo

##############################################
# ROI / TRI ROI 설정
##############################################
# 기본 ROI (x1,y1,x2,y2)
ROI_RECT=4,62,712,375
# tri 모드 ROI (좌/중/우)
TRI_ROI_LEFT=0,120,600,430
TRI_ROI_CENTER=600,120,1320,430
TRI_ROI_RIGHT=1320,120,2000,430

##############################################
# 기본 CCTV 설정
##############################################
CURRENT_CCTV_NAME=[샘플]고삼터널-5/11
CURRENT_CCTV_URL=https://example.com/sample_stream.m3u8

# ROI 좌표 범위 (위경도)
CCTV_MIN_X=127.0
CCTV_MAX_X=127.1
CCTV_MIN_Y=34.9
CCTV_MAX_Y=35.0

##############################################
# 시스템/탐지 파라미터
##############################################
DEBUG_MODE=true
DETECTION_INTERVAL=1
DETECTION_CONFIDENCE=0.2
TRACKER_MAX_AGE=30
TRACKER_IOU_THRESHOLD=0.25

##############################################
# 해상도/표시 설정
##############################################
FRAME_WIDTH=720
FRAME_HEIGHT=480
YOLO_WIDTH=640
YOLO_HEIGHT=640
DISPLAY_WIDTH=1440
DISPLAY_HEIGHT=960

##############################################
# HLS 스트림 설정
##############################################
HLS_URL_UPDATE_INTERVAL=20
HLS_BUFFER_SIZE=60
HLS_RECONNECT_THRESHOLD=10

##############################################
# ReID 설정
##############################################
REID_SIMILARITY_THRESHOLD=0.7
REID_MAX_AGE_SECONDS=300

##############################################
# 경로 설정
##############################################
DATA_DIR=data
LOG_DIR=logs
MODEL_DIR=models
